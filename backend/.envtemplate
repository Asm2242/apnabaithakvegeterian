# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- Database (required) ----
MONGO_URI="mongodb://127.0.0.1:27017/apna_baithak"
# Production example:
# MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/apna_baithak"

# ---- Auth (required) ----
JWT_SECRET="replace-with-a-long-random-secret"
# Used to hash OTPs — change in production
OTP_PEPPER="replace-with-another-long-random-secret"

# ---- Server ----
PORT=4000
# Comma-separated allowed browser origins. Requests without Origin
# (curl, server-to-server, mobile apps) are always allowed.
# Example: CORS_ORIGINS="https://apnabaithak.vercel.app,https://admin.example.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---- Payments ----
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_SECRET="replace-with-razorpay-secret"

# ---- OTP / SMS provider ----
# switch provider with OTP_PROVIDER: msg91 | twofactor | textlocal | fast2sms | console
OTP_PROVIDER="twofactor"

# 1) MSG91 (2,000 free SMS on signup, needs DLT + approved sender/template)
MSG91_API_KEY=""
MSG91_SENDER=""
MSG91_TEMPLATE_ID=""

# 2) 2Factor (free 1000 OTP SMS/month, NO DLT needed - easiest)
#    get key from https://2factor.in -> account -> API key
TWO_FACTOR_API_KEY=""

# 3) Textlocal (free trial, needs DLT)
TEXTLOCAL_USERNAME=""
TEXTLOCAL_PASSWORD=""
TEXTLOCAL_SENDER=""

# 4) Fast2SMS (needs DLT)
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID="FSTSMS"

# show the OTP on screen instead of sending SMS (TESTING ONLY - never in production)
OTP_DEV_SHOW=""
